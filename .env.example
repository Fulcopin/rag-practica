# Copia este archivo como .env y rellena tus valores.
# iniciar.ps1 lo lee automaticamente; main.py tambien (sin dependencias).

# ===== LLM (gratis) =====
# "openai" = cualquier API compatible con OpenAI: Groq, Gemini, OpenRouter, LM Studio
# "ollama" = modelo local (necesita RAM libre)
LLM_BACKEND=openai

# --- Opcion 1: Groq (https://console.groq.com/keys) ---
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.8-27b
# Alternativa en Groq: OPENAI_MODEL=openai/gpt-oss-120b + OPENAI_REASONING=low

# --- Opcion 2: Gemini (https://aistudio.google.com/apikey) ---
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#OPENAI_API_KEY=AIza...
#OPENAI_MODEL=gemini-2.5-flash

# --- Opcion 3: Ollama local (sin cuentas ni internet) ---
#LLM_BACKEND=ollama
#OLLAMA_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=gemma2:2b

# ===== Embeddings (local, gratis) =====
EMB_BACKEND=local
LOCAL_EMB_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Carpeta del modelo ONNX (240 MB). Por defecto ./models_cache
#FASTEMBED_CACHE=C:\ruta\a\models_cache

# ===== Qdrant =====
# Sin QDRANT_URL se usa Qdrant LOCAL en ./qdrant_data (gratis, sin cuenta)
#QDRANT_PATH=C:\ruta\a\qdrant_data
# Qdrant Cloud (https://cloud.qdrant.io):
#QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
#QDRANT_API_KEY=xxxxxxxxxxxxxxxx
QDRANT_COLLECTION=cvs

# ===== Hugging Face (opcional y de pago: 402 sin creditos) =====
# Solo si pones LLM_BACKEND=hf o EMB_BACKEND=hf
#HF_TOKEN=hf_xxx
#LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#LLM_PROVIDER=novita
